# MongoDB Configuration
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_FALLBACK_URI=mongodb://127.0.0.1:27017/vroomy

# Authentication (use a unique random value; never commit the real .env)
JWT_SECRET=<generate-a-long-random-secret>
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=<set-a-strong-bootstrap-password>
ADMIN_NAME=REVEX Admin
ADMIN_SETUP_KEY=<one-time-admin-setup-key>
ENABLE_DEMO_RESET=false
DEMO_OWNER_PASSWORD=<optional-demo-owner-password>

# Optional payment gateway
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional frontend origin for stricter deployments
FRONTEND_URL=http://localhost:5000
PORT=5000

# Configurable base prices used only for the transparent suggestion feature
PRICING_BASE_BIKE=80
PRICING_BASE_SCOOTER=100
PRICING_BASE_CAR=300
PRICING_BASE_OTHER=150
