# =============================================================================
# REVEX 1.3  ·  ENVIRONMENT TEMPLATE
#
# Copy this file to `.env` and fill in the blanks. NEVER commit the real `.env`.
# Every value here is a NAME plus an empty or obviously-fake placeholder: this
# file contains no working credentials.
#
#   cp .env.example .env        (macOS / Linux / Git Bash)
#   copy .env.example .env      (Windows cmd / PowerShell)
#
# The server reads `backend/.env` first and then the project-root `.env`, so you
# can keep one file at the root, or one inside backend/, or both.
# =============================================================================

# ---------------------------------------------------------------- MongoDB ----
# REQUIRED. Either a MongoDB Atlas SRV string or a local mongodb:// URL.
# Put the database name in the path, e.g. .../vroomy  (Atlas otherwise
# silently connects to a database called "test").
MONGODB_URI=

# REQUIRED when MONGODB_URI does not name a database. Ignored otherwise.
MONGODB_DB_NAME=vroomy

# Optional second connection string, used only if the first one fails.
MONGODB_FALLBACK_URI=

# Set to true ONLY for local development. In production keep it false so data
# can never be silently written to the wrong database.
ALLOW_LOCAL_MONGO_FALLBACK=false

# --------------------------------------------------------------- auth/secrets
# REQUIRED. Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Bootstrap admin. The admin account is created on first boot when it does not
# already exist. After the account exists these are only used to rename it.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=REVEX Admin

# One-time key for the /api/auth/setup-admin endpoint and admin-setup.html.
# Leave empty to disable that endpoint entirely.
ADMIN_SETUP_KEY=

# Public base URL of this deployment. Used to build password-reset links.
# Behind Render/Railway/Vercel, PORT is injected automatically - do not set it.
PUBLIC_URL=http://localhost:5001
PORT=5001

# Per-IP auth rate limiting window ceiling. Defaults are already conservative
# (login 20, register 10, password reset 10, admin setup 5 per 15 minutes).
AUTH_RATE_LIMIT_MAX=

# Demo/test conveniences. Keep false outside development.
ENABLE_DEMO_RESET=false
DEMO_OWNER_PASSWORD=

# ------------------------------------------------------------------- SMTP ----
# Needed only for real password-reset email. Without it, the forgot-password
# flow returns the reset link in the response so you can still test locally.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ---------------------------------------------------------------- Razorpay ---
# Leave BOTH blank and the app runs in test-payment mode: the payment screens
# offer a clearly labelled test payment, and the server records it with
# paymentMethod "demo" so it can never be mistaken for real money.
# Set both to enable the real Razorpay Standard Checkout.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_CURRENCY=INR
# normal | optimised
RAZORPAY_REFUND_SPEED=normal

# ------------------------------------------------------------- Money/pricing -
# Platform commission. Used by the ride quote, the rental quote and every
# revenue split in the admin reports, so the numbers always agree.
PLATFORM_FEE_PERCENT=10

# ------------------------------------------------------------- Cancellation --
# ONE centralised, env-configurable policy. There are no hard-coded
# percentages anywhere in the code; every cancellation, owner decline and admin
# cancellation reads these values.
#
# Free cancellation window, in hours before the start time. Cancelling this far
# ahead is free. Set to 0 to DISABLE the free window (the fee then always
# applies - 0 never means "always free").
CANCEL_FREE_WINDOW_HOURS=6

# Cancellation fee, per actor, as a percentage of the amount paid.
CANCEL_FEE_PERCENT_USER=10
CANCEL_FEE_PERCENT_OWNER=25
CANCEL_FEE_PERCENT_ADMIN=0

# Optional flat fee added on top of the percentage, per actor.
CANCEL_FEE_FLAT_USER=0
CANCEL_FEE_FLAT_OWNER=0
CANCEL_FEE_FLAT_ADMIN=0

# Hard ceiling for the cancellation fee, per actor. 0 means no ceiling.
CANCEL_FEE_MAX_USER=1500
CANCEL_FEE_MAX_OWNER=2500
CANCEL_FEE_MAX_ADMIN=0

# Multiplier applied to an owner-caused fee (1 = as configured).
CANCEL_OWNER_PENALTY_MULTIPLIER=1

# ------------------------------------------------------- REVEX Assistant ------
# A Google AI Studio key is ALL you need. Leave CHAT_API_URL blank and the correct
# :generateContent endpoint is derived from the key and the model name.
#
# Set CHAT_API_URL only for a different provider. The wire format comes from the URL:
#   ... ends in /chat/completions  -> OpenAI-compatible (Authorization: Bearer)
#   anything else                  -> Gemini :generateContent
# A base such as https://host/v1beta/models is completed for you. It must be https
# (http is allowed only for localhost).
#
# CHAT_API_KEY — or the legacy GEMINI_API_KEY / GEMINI_MODEL, still honoured — never
# leaves the server. With no key the chat screen loads and says what to set; it
# never pretends to work.
CHAT_API_KEY=
CHAT_API_URL=
CHAT_API_MODEL=gemini-2.5-flash
CHAT_TEMPERATURE=0.35
CHAT_MAX_OUTPUT_TOKENS=450
CHAT_TIMEOUT_MS=20000

# ------------------------------------------------------------------- CORS ----
# A request whose Origin matches the host it was sent to is ALWAYS allowed, so
# when the pages and the API come from the same host there is nothing to set.
# Only needed when the frontend is hosted on a DIFFERENT host. Comma separated;
# each entry is an exact origin, a domain suffix starting with "." (any
# subdomain), or "*" to allow anything.
#   CORS_ALLOWED_ORIGINS=https://app.example.com,.vercel.app
CORS_ALLOWED_ORIGINS=
# Legacy single-origin variable, honoured when CORS_ALLOWED_ORIGINS is empty.
FRONTEND_URL=http://localhost:5001

# --------------------------------------------------------- Mapbox / Smart Route
# Smart Route shows the REAL driving road on a map, lets a rider drop a pin
# anywhere along that road to join the ride, and charges them by the distance
# they actually travel.
#
# TWO TOKENS, TWO JOBS - do not swap them.
#
#   MAPBOX_ACCESS_TOKEN  a SECRET token (sk.ey...).  Server side only. Used for
#                        Geocoding v5 and Directions v5. It is NEVER sent to a
#                        browser, so it can never leak from a page source.
#   MAPBOX_PUBLIC_TOKEN  a PUBLISHABLE token (pk.ey...). Safe in the browser:
#                        it is what Mapbox GL JS uses to draw the map, and it is
#                        served from GET /api/rides/map-config.
#
# SAMPLE VALUES - replace both with your own from
# https://account.mapbox.com/access-tokens/ and the feature switches to real
# Mapbox road routing, real Mapbox place search and the real Mapbox basemap:
#
#   MAPBOX_ACCESS_TOKEN=sk.sample_replace_this_with_your_mapbox_secret_token
#   MAPBOX_PUBLIC_TOKEN=pk.sample_replace_this_with_your_mapbox_public_token
#
# The public token needs the Mapbox scopes:
#   styles:read, fonts:read, tiles:read
# The secret token additionally needs:
#   styles:tiles:read
#
# NO TOKEN AT ALL? THE FEATURE STILL WORKS.
#
# With both blank, REVEX uses the key-free public OSRM routing service for REAL
# road geometry and a built-in gazetteer of Indian towns for place names, then
# draws the route on the built-in map widget. Mid-route joining and distance
# pricing stay fully functional; only the basemap tiles and Mapbox search are
# missing. The UI states which of the three it is using rather than pretending.
MAPBOX_ACCESS_TOKEN=
MAPBOX_PUBLIC_TOKEN=

# The map style the browser loads. A `mapbox://styles/...` URL needs a token.
MAPBOX_STYLE_URL=mapbox://styles/mapbox/streets-v12

# Mapbox GL JS version loaded from the CDN. Bump it to pick up fixes.
MAPBOX_GL_VERSION=3.9.4

# Endpoints. Override only if you proxy Mapbox through your own gateway; the
# standard {query} / {coordinates} placeholders must survive.
MAPBOX_GEOCODING_BASE=https://api.mapbox.com/geocoding/v5/mapbox.places
MAPBOX_DIRECTIONS_BASE=https://api.mapbox.com/directions/v5/mapbox/driving

# Bias place search to this country (ISO 3166-1 alpha-2). Blank = no bias.
MAPBOX_COUNTRY=in

# Network + cache. Every geocode and every route is cached, so a repeated search
# costs nothing and the monthly request allowance is not burned per keystroke.
MAPBOX_TIMEOUT_MS=8000
MAPBOX_CACHE_TTL_MS=600000
MAPBOX_CACHE_MAX_ENTRIES=500

# ------------------------------------------------------------------ matching -
# HOW CLOSE a point has to be to a ride's road before the rider counts as "on"
# this ride. A pickup is a city centre and the road is often a highway bypass, so
# the two are routinely ~10 km apart even though everyone agrees the driver
# "goes to Rajkot". Too tight rejects almost every real city pickup; too loose
# lets a point in the wrong district match.
MAPBOX_ROUTE_TOLERANCE_KM=10

# How close a town has to be to the road before the route is described as going
# "via" it. Slightly looser than the rider tolerance, for the same reason.
MAPBOX_VIA_TOLERANCE_KM=12

# How many "via" towns a route may report, so a long journey is not buried in
# twenty minor places.
MAPBOX_VIA_LIMIT=6

# A rider who joins at least this far along the route is treated as a genuine
# mid-route join, and is charged for that part of the distance only.
SMART_ROUTE_MID_ROUTE_KM=5

# Joining for less than this many kilometres is refused: it saves the rider a
# token amount and costs the owner a stop, a wait and a detour.
SMART_ROUTE_MIN_TRAVEL_KM=5

# Refuse a "match" that is less than this fraction of the whole route, so a
# one-kilometre overlap is never presented as a ride.
MAPBOX_MIN_MATCH_FRACTION=0.03

# How far the rider's own heading may differ from the ride's start-to-end
# heading before it counts as a different trip rather than a shorter one.
# 120 degrees accepts any sensible "same road" heading and rejects the reverse.
SMART_ROUTE_MAX_HEADING_DIFFERENCE_DEG=120

# ------------------------------------------------------------------ fallback -
# The key-free public OSRM service, used for real road geometry ONLY when no
# Mapbox access token is set. Turn it off to force straight-line estimates.
SMART_ROUTE_PUBLIC_ROUTER_ENABLED=true
SMART_ROUTE_PUBLIC_ROUTER_BASE=https://router.project-osrm.org/route/v1/driving

# The built-in gazetteer of Indian towns plus the straight-line estimate. Set to
# false to make an unresolvable place a hard error instead of a silent fallback.
MAPBOX_FALLBACK_ENABLED=true

# ----------------------------------------------------------------- Pricing ---
# Base prices used ONLY for the transparent "suggested rental price" helper.
PRICING_BASE_BIKE=80
PRICING_BASE_SCOOTER=100
PRICING_BASE_CAR=300
PRICING_BASE_OTHER=150
