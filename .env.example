# MongoDB Configuration
MONGODB_URI=mongodb+srv://<username>:<password>@revex.r2zrw0p.mongodb.net/vroomy
MONGODB_FALLBACK_URI=mongodb://127.0.0.1:27017/vroomy

# Database used when MONGODB_URI does not name one (Atlas defaults to "test").
MONGODB_DB_NAME=vroomy

# Allow falling back to local MongoDB when Atlas fails. Keep false in production
# so data is never silently written to the wrong database.
ALLOW_LOCAL_MONGO_FALLBACK=false

# Authentication (use a unique random value; never commit the real .env)
JWT_SECRET=<generate-a-long-random-secret>
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=<set-a-strong-bootstrap-password>
ADMIN_NAME=REVEX Admin
ADMIN_SETUP_KEY=<one-time-admin-setup-key>
ENABLE_DEMO_RESET=false
DEMO_OWNER_PASSWORD=<optional-demo-owner-password>
PUBLIC_URL=http://localhost:5001
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional payment gateway
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- CORS -------------------------------------------------------------------
# A request whose Origin matches the host it was sent to is ALWAYS allowed, so
# when the pages and the API are served from the same host (the normal Render /
# Vercel / local setup) there is nothing to configure here.
#
# Only set CORS_ALLOWED_ORIGINS if the frontend is hosted on a DIFFERENT host.
# Comma separated; each entry is an exact origin, a domain suffix starting with
# "." (any subdomain), or "*" to allow anything.
#   CORS_ALLOWED_ORIGINS=https://app.example.com,.vercel.app
CORS_ALLOWED_ORIGINS=
# Legacy single-origin variable, still honoured when CORS_ALLOWED_ORIGINS is empty.
FRONTEND_URL=http://localhost:5001
# Render/Railway/Fly inject PORT automatically -- do not set it there.
PORT=5001

# Auth rate limiting (per IP). Defaults: login 20, register 10, password reset
# 10, admin setup 5 per 15 min. Raise for automated tests or shared NAT.
AUTH_RATE_LIMIT_MAX=

# Configurable base prices used only for the transparent suggestion feature
PRICING_BASE_BIKE=80
PRICING_BASE_SCOOTER=100
PRICING_BASE_CAR=300
PRICING_BASE_OTHER=150
