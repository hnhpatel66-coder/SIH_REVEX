# =============================================================================
# REVEX 1.3  ·  BACKEND ENVIRONMENT TEMPLATE
#
# Copy to `backend/.env` and fill in the blanks. The server reads this file
# FIRST and then the project-root `.env`, so keep secrets in ONE place only.
#
# The root `.env.example` documents the same variables. This file exists so the
# backend can be deployed on its own (Render, Railway, a container) without the
# frontend files.
#
# THIS FILE CONTAINS NO CREDENTIALS. Every value is a name plus an empty or
# obviously-fake placeholder.
# =============================================================================

# ---------------------------------------------------------------- MongoDB ----
MONGODB_URI=
MONGODB_DB_NAME=vroomy
MONGODB_FALLBACK_URI=
ALLOW_LOCAL_MONGO_FALLBACK=false

# --------------------------------------------------------------- auth/secrets
# REQUIRED. Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=REVEX Admin
ADMIN_SETUP_KEY=

# Injected automatically by Render / Railway / Fly. Do not set it there.
PORT=5001
PUBLIC_URL=http://localhost:5001
AUTH_RATE_LIMIT_MAX=

ENABLE_DEMO_RESET=false
DEMO_OWNER_PASSWORD=

# ------------------------------------------------------------------- SMTP ----
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ---------------------------------------------------------------- Razorpay ---
# Both blank => test-payment mode (a labelled test payment, stored as
# paymentMethod "demo", never as real money).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_CURRENCY=INR
RAZORPAY_REFUND_SPEED=normal

# ------------------------------------------------------------- Money/pricing -
PLATFORM_FEE_PERCENT=10

# ------------------------------------------------------------- Cancellation --
CANCEL_FREE_WINDOW_HOURS=6
CANCEL_FEE_PERCENT_USER=10
CANCEL_FEE_PERCENT_OWNER=25
CANCEL_FEE_PERCENT_ADMIN=0
CANCEL_FEE_FLAT_USER=0
CANCEL_FEE_FLAT_OWNER=0
CANCEL_FEE_FLAT_ADMIN=0
CANCEL_FEE_MAX_USER=1500
CANCEL_FEE_MAX_OWNER=2500
CANCEL_FEE_MAX_ADMIN=0
CANCEL_OWNER_PENALTY_MULTIPLIER=1

# ------------------------------------------------------- REVEX Assistant ------
# CHAT_API_KEY is the only required value. With a Google AI Studio key
# (it starts "AIza") and CHAT_API_URL left blank, the correct :generateContent
# endpoint is derived from the key and the model. GEMINI_API_KEY / GEMINI_MODEL
# are still accepted for older .env files.
# Set CHAT_API_URL only for another provider; a URL ending in /chat/completions
# selects the OpenAI-compatible dialect, anything else is treated as Gemini.
CHAT_API_KEY=
CHAT_API_URL=
CHAT_API_MODEL=gemini-2.5-flash
CHAT_TEMPERATURE=0.35
CHAT_MAX_OUTPUT_TOKENS=450
CHAT_TIMEOUT_MS=20000

# ------------------------------------------------------------------- CORS ----
CORS_ALLOWED_ORIGINS=
FRONTEND_URL=http://localhost:5001
